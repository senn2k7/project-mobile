<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema utama aplikasi TemanStudi -->
    <style name="Base.Theme.TemanStudi"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">#1D5EFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="android:statusBarColor">#F5FAFF</item>
        <item name="android:navigationBarColor">#F5FAFF</item>
        <item name="android:windowLightStatusBar">true</item>

    </style>

    <!-- Tema aplikasi setelah splash screen -->
    <style name="Theme.TemanStudi"
        parent="Base.Theme.TemanStudi" />

    <!-- Tema splash screen sistem Android -->
    <style name="Theme.App.SplashScreen"
        parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F5FAFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.TemanStudi</item>
    </style>



</resources>
