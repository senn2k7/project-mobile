<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAFF">

    <!-- Lingkaran dekoratif kanan atas -->
    <View
        android:layout_width="310dp"
        android:layout_height="310dp"
        android:layout_gravity="top|end"
        android:translationX="115dp"
        android:translationY="-60dp"
        android:background="@drawable/splash_circle" />

    <!-- Lingkaran dekoratif kiri bawah -->
    <View
        android:layout_width="390dp"
        android:layout_height="390dp"
        android:layout_gravity="bottom|start"
        android:translationX="-195dp"
        android:translationY="195dp"
        android:background="@drawable/splash_circle" />

    <!-- Konten splash screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:contentDescription="Logo TemanStudi"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="TemanStudi"
            android:textColor="#19365F"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="Belajar Lebih Mudah dengan AI"
            android:textColor="#19365F"
            android:textSize="17sp" />

    </LinearLayout>

</FrameLayout>
