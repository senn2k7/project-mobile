<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="TemanStudi"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TemanStudi">

        <!-- Halaman onboarding -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <!-- Halaman Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Halaman Mode Pembelajaran -->
        <activity
            android:name=".ModePembelajaranActivity"
            android:exported="false" />

        <!-- Halaman Pilih Peran -->
        <activity
            android:name=".PilihPeranActivity"
            android:exported="false" />

        <!-- Halaman Daftar Kelas Saya (Pengajar) -->
        <activity
            android:name=".KelasSayaActivity"
            android:exported="false" />

        <!-- Halaman Detail Kelas (Pengajar Institusi) -->
        <activity
            android:name=".DetailKelasActivity"
            android:exported="false" />

        <!-- Halaman Buat Kuis (Pengajar Institusi) -->
        <activity
            android:name=".BuatKuisActivity"
            android:exported="false" />

        <!-- Halaman Daftar Tugas (Pengajar Institusi) -->
        <activity
            android:name=".TugasActivity"
            android:exported="false" />

        <!-- Halaman Detail Tugas (Pengajar Institusi) -->
        <activity
            android:name=".DetailTugasActivity"
            android:exported="false" />

        <!-- Halaman Pengumpulan Tugas (Pengajar Institusi) -->
        <activity
            android:name=".PengumpulanTugasActivity"
            android:exported="false" />

        <!-- Lengkapi Profil Pengajar Mandiri -->
        <activity
            android:name=".LengkapiProfilPengajarActivity"
            android:exported="false" />

        <!-- Lengkapi Profil Pelajar Mandiri -->
        <activity
            android:name=".LengkapiProfilPelajarActivity"
            android:exported="false" />

        <!-- Halaman Utama (Home) -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- Halaman utama untuk memulai aplikasi -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.App.SplashScreen"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Lupa password dan Register -->
        <activity android:name=".RegisterActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ForgotPasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
